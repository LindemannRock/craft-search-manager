{% set configError = item.source == 'config' ? (configIndexErrors[item.handle] ?? null) : null %}

{% if configError %}
    {% include 'lindemannrock-base/_components/badge' with {
        label: 'Error'|t('search-manager'),
        value: 'error',
        colorSet: 'indexStatus',
        title: configError,
    } only %}
{% else %}
    {% include 'lindemannrock-base/_components/badge' with {
        label: item.enabled ? 'Enabled'|t('search-manager') : 'Disabled'|t('search-manager'),
        value: item.enabled ? 'enabled' : 'disabled',
        colorSet: 'indexStatus',
    } only %}
{% endif %}
