{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = indexReference.displayName %}
{% set fullPageForm = false %}
{% set selectedSubnavItem = 'indices' %}
{% set setupIncompleteSummary = include('search-manager/_partials/setup-incomplete-summary', {
    selectedSubnavItem: selectedSubnavItem,
})|trim %}
{% set indexFindingsSummary = include('search-manager/_components/_index-findings', {
    findings: indexReference.findings,
    presentation: 'box',
})|trim %}
{% set errorSummary = [setupIncompleteSummary, indexFindingsSummary]|filter(summary => summary)|join("\n") %}

{% set canRebuild = canRebuild ?? false %}
{% set canClear = canClear ?? false %}
{% set canClearCache = canClearCache ?? false %}
{% set canManageBackends = canManageBackends ?? false %}
{% set globalSettings = craft.searchManager.getSettings() %}

{% set crumbs = [
    { label: searchHelper.fullName, url: url('search-manager') },
    { label: 'Indices'|t('search-manager'), url: url('search-manager/indices') },
    { label: indexReference.displayName }
] %}

{% block content %}
	<div class="pane">
		<h2>{{ 'Configuration'|t('search-manager') }}</h2>
		{% if index.isFromConfig() %}
			<p class="light">{{ 'This index is defined in your config file and cannot be edited here.'|t('search-manager') }}</p>
			{% set configurationDisplay = index.rawConfigDisplay %}
		{% else %}
			{% set configurationDisplay = index.toConfigArray()|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) %}
		{% endif %}
		<pre style="background: #f3f7fc; padding: 14px; border-radius: 4px; overflow-x: auto; font-size: 12px;"><code>{{ configurationDisplay }}</code></pre>
	</div>

	{% include 'lindemannrock-base/_components/plugin-credit' %}
{% endblock %}

{% block details %}
	{# Enabled toggle (disabled, showing current state) #}
	<div class="meta">
		{{ forms.lightswitchField({
			label: 'Enabled'|t('search-manager'),
			instructions: index.isFromConfig() ? 'Set via config/search-manager.php. Edit the file to change.'|t('search-manager') : null,
			id: 'enabled',
			on: index.enabled,
			disabled: true
		}) }}

		{{ forms.lightswitchField({
			label: 'Skip Entries Without URL'|t('search-manager'),
			instructions: index.isFromConfig() ? 'Set via config/search-manager.php. Edit the file to change.'|t('search-manager') : null,
			id: 'skipEntriesWithoutUrl',
			on: index.skipEntriesWithoutUrl,
			disabled: true
		}) }}

		{% if index.supportsSplitSections() %}
			{{ forms.lightswitchField({
				label: 'Split Sections'|t('search-manager'),
				instructions: index.isFromConfig() ? 'Set via config/search-manager.php. Edit the file to change.'|t('search-manager') : null,
				id: 'splitSections',
				on: index.splitSections ?? false,
				disabled: true
			}) }}
		{% endif %}

		{{ forms.lightswitchField({
			label: 'Disable Stop Words'|t('search-manager'),
			instructions: index.isFromConfig() ? 'Set via config/search-manager.php. Edit the file to change.'|t('search-manager') : null,
			id: 'disableStopWords',
			on: index.disableStopWords ?? false,
			disabled: true
		}) }}

		{# Actions #}
		{% if canRebuild or canClear or (canClearCache and (globalSettings.enableCache or globalSettings.enableAutocompleteCache)) %}
			<div class="field">
				<div class="heading">
					<label>{{ 'Actions'|t('search-manager') }}</label>
				</div>
				<div class="input">
					<button type="button" class="btn menubtn" data-icon="settings" style="width: 100%;">{{ "Index Actions"|t('search-manager') }}</button>
					<div class="menu">
						<ul>
							{% if canRebuild %}
							<li>
								{% if indexReference.actions.targetedRebuild.allowed %}
									<a id="rebuild-btn" href="#">{{ "Rebuild Index"|t('search-manager') }}</a>
								{% else %}
									<a class="disabled" aria-disabled="true" title="{{ indexReference.actions.targetedRebuild.reason }}">{{ "Rebuild Index"|t('search-manager') }}</a>
								{% endif %}
							</li>
							{% if indexReference.actions.syncCount.visible %}
								<li>
									{% if indexReference.actions.syncCount.allowed %}
										<a id="sync-count-btn" href="#">{{ "Sync Count from Backend"|t('search-manager') }}</a>
									{% else %}
										<a class="disabled" aria-disabled="true" title="{{ indexReference.actions.syncCount.reason }}">{{ "Sync Count from Backend"|t('search-manager') }}</a>
									{% endif %}
								</li>
							{% endif %}
							{% endif %}
							{% if canClear %}
							<li>
								{% if indexReference.actions.clearData.allowed %}
									<a id="clear-btn" href="#" class="error">{{ "Clear Index"|t('search-manager') }} ({{ index.documentCount|number_format }})</a>
								{% else %}
									<a class="disabled" aria-disabled="true" title="{{ indexReference.actions.clearData.reason }}">{{ "Clear Index"|t('search-manager') }} ({{ index.documentCount|number_format }})</a>
								{% endif %}
							</li>
							{% endif %}
							{% if canClearCache and (globalSettings.enableCache or globalSettings.enableAutocompleteCache) %}
							<li><hr class="padded"></li>
							<li>
								{% if indexReference.actions.clearCache.allowed %}
									<a id="clear-cache-btn" href="#">{{ "Clear Index Cache"|t('search-manager') }}</a>
								{% else %}
									<a class="disabled" aria-disabled="true" title="{{ indexReference.actions.clearCache.reason }}">{{ "Clear Index Cache"|t('search-manager') }}</a>
								{% endif %}
							</li>
							{% endif %}
						</ul>
					</div>
				</div>
			</div>
		{% endif %}
	</div>

	{# Index Info #}
	<fieldset>
		<dl class="meta read-only">
			{% if index.id %}
				<div class="data">
					<dt class="heading">{{ 'ID'|t('search-manager') }}</dt>
					<dd class="value">{{ index.id }}</dd>
				</div>
			{% endif %}
			<div class="data">
				<dt class="heading">{{ 'Status'|t('search-manager') }}</dt>
				<dd class="value">
					{% include 'search-manager/_components/_effective-status' with {
						status: indexReference.status,
						presentation: 'sidebar',
					} only %}
				</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Source'|t('search-manager') }}</dt>
				<dd class="value">
					{% include 'lindemannrock-base/_components/status-dot' with {
						value: index.source,
						colorSet: 'configSource',
					} only %}
					<span>{{ index.source == 'config' ? 'Config File'|t('search-manager') : 'Database'|t('search-manager') }}</span>
				</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Handle'|t('search-manager') }}</dt>
				<dd class="value"><code>{{ index.handle }}</code></dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Element Type'|t('search-manager') }}</dt>
				<dd class="value">{{ elementTypeLabels[index.elementType] ?? (index.elementType|split('\\')|last) }}</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Retrievable Fields'|t('search-manager') }}</dt>
				<dd class="value">
					{% if index.retrievableFields == ['*'] %}
						<span>{{ 'All fields (*)'|t('search-manager') }}</span>
					{% elseif index.retrievableFields is empty %}
						<span>{{ 'No custom fields'|t('search-manager') }}</span>
					{% else %}
						{% for fieldHandle in index.retrievableFields %}
							<code>{{ fieldHandle }}</code>{% if not loop.last %}<br>{% endif %}
						{% endfor %}
					{% endif %}
				</dd>
			</div>
			{% set configuredBackend = index.configuredBackend %}
			<div class="data">
				<dt class="heading">{{ 'Backend'|t('search-manager') }}</dt>
				<dd class="value">
					{% if configuredBackend %}
						{% if canManageBackends %}
							<a href="{{ url('search-manager/backends/view/' ~ configuredBackend.handle) }}">{{ configuredBackend.name }}</a>
						{% else %}
							{{ configuredBackend.name }}
						{% endif %}
					{% elseif not index.effectiveBackendType %}
						<span class="light">{{ 'Default'|t('search-manager') }}</span>
					{% endif %}
				</dd>
			</div>
			{% set backendType = index.effectiveBackendType %}
			{% if backendType %}
				<div class="data">
					<dt class="heading">{{ 'Type'|t('search-manager') }}</dt>
					<dd class="value">
						{% include 'lindemannrock-base/_components/status-dot' with {
							value: backendType,
							colorSet: 'backendType',
						} only %}
						<span>{{ configuredBackend ? configuredBackend.getTypeLabel() : (backendType|capitalize) }}</span>
					</dd>
				</div>
			{% endif %}
			{% set redisConnectionInfo = index.redisSafePresentation %}
			{% if redisConnectionInfo %}
				<div class="data">
					<dt class="heading">{{ 'Database'|t('search-manager') }}</dt>
					<dd class="value"><code>{{ redisConnectionInfo.databaseLabel }}</code></dd>
				</div>
			{% endif %}
			<div class="data">
				<dt class="heading">{{ 'Documents'|t('search-manager') }}</dt>
				<dd class="value">
					{% set expected = index.expectedCount %}
					{% set comparison = index.comparisonCount %}
					{% if comparison is null %}
					{% elseif comparison == expected %}
						{% include 'lindemannrock-base/_components/status-dot' with { value: 'ok', colorSet: 'healthStatus' } only %}
					{% elseif comparison < expected %}
						{% include 'lindemannrock-base/_components/status-dot' with { value: 'low', colorSet: 'healthStatus' } only %}
					{% else %}
						{% include 'lindemannrock-base/_components/status-dot' with { value: 'high', colorSet: 'healthStatus' } only %}
					{% endif %}
					{{ index.documentCount|number_format }}{% if not index.splitSections %}&nbsp;/&nbsp;{{ expected|number_format }}{% endif %}
				</dd>
			</div>
			<div class="data">
				<dt class="heading">{{ 'Last Indexed'|t('search-manager') }}</dt>
				<dd class="value">
					{% if index.lastIndexed %}
						{{ index.lastIndexed|lrDatetime }}
					{% else %}
						<span class="light">{{ 'Never'|t('search-manager') }}</span>
					{% endif %}
				</dd>
			</div>
		</dl>
	</fieldset>
{% endblock %}

{% js %}
// Initialize menu buttons
document.querySelectorAll('.menubtn').forEach(btn => {
	if (typeof Craft !== 'undefined' && Craft.MenuBtn) {
		new Craft.MenuBtn(btn);
	}
});

// Helper function for form submissions
function submitAction(action, indexId) {
	const form = document.createElement('form');
	form.method = 'POST';
	form.action = Craft.getActionUrl(action);

	const csrfInput = document.createElement('input');
	csrfInput.type = 'hidden';
	csrfInput.name = {{ craft.app.config.general.csrfTokenName|json_encode|raw }};
	csrfInput.value = {{ craft.app.request.csrfToken|json_encode|raw }};
	form.appendChild(csrfInput);

	const indexIdInput = document.createElement('input');
	indexIdInput.type = 'hidden';
	indexIdInput.name = 'indexId';
	indexIdInput.value = indexId;
	form.appendChild(indexIdInput);

	document.body.appendChild(form);
	form.submit();
}

// Rebuild button
{% if canRebuild %}
document.getElementById('rebuild-btn')?.addEventListener('click', function(e) {
	e.preventDefault();
	if (confirm({{ "Rebuild index? This will re-index all elements."|t('search-manager')|json_encode|raw }})) {
		submitAction('search-manager/indices/rebuild', {{ index.handle|json_encode|raw }});
	}
});
{% endif %}

// Clear button
{% if canClear %}
document.getElementById('clear-btn')?.addEventListener('click', function(e) {
	e.preventDefault();
	if (confirm({{ "Clear all data from this index? This cannot be undone."|t('search-manager')|json_encode|raw }})) {
		submitAction('search-manager/indices/clear', {{ index.handle|json_encode|raw }});
	}
});
{% endif %}

// Clear cache button
{% if canClearCache and (globalSettings.enableCache or globalSettings.enableAutocompleteCache) %}
document.getElementById('clear-cache-btn')?.addEventListener('click', function(e) {
	e.preventDefault();
	Craft.sendActionRequest('POST', 'search-manager/indices/clear-cache', {
		data: { indexId: {{ index.handle|json_encode|raw }} }
	}).then(function(response) {
		if (response.data.success) {
			Craft.cp.displayNotice(response.data.message || {{ "Cache cleared"|t('search-manager')|json_encode|raw }});
		} else {
			Craft.cp.displayError(response.data.error || {{ "Failed to clear cache"|t('search-manager')|json_encode|raw }});
		}
	}).catch(function(error) {
		Craft.cp.displayError({{ "Failed to clear cache"|t('search-manager')|json_encode|raw }});
	});
});
{% endif %}

// Sync count button
{% if canRebuild and index.effectiveBackendType in ['algolia', 'meilisearch', 'typesense'] %}
document.getElementById('sync-count-btn')?.addEventListener('click', function(e) {
	e.preventDefault();
	Craft.sendActionRequest('POST', 'search-manager/indices/sync-count', {
		data: { indexId: {{ index.handle|json_encode|raw }} }
	}).then(function(response) {
		if (response.data.success) {
			Craft.cp.displayNotice(response.data.message || {{ "Count synced"|t('search-manager')|json_encode|raw }});
			setTimeout(() => window.location.reload(), 1000);
		} else {
			Craft.cp.displayError(response.data.error || {{ "Failed to sync count"|t('search-manager')|json_encode|raw }});
		}
	}).catch(function(error) {
		Craft.cp.displayError({{ "Failed to sync count"|t('search-manager')|json_encode|raw }});
	});
});
{% endif %}
{% endjs %}
