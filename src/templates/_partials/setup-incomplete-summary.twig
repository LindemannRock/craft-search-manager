{% set currentSubnavItem = selectedSubnavItem ?? '' %}
{% set setupStatus = setupStatus ?? craft.app.plugins.getPlugin('search-manager').setup.getStatus() %}
{% set setupMessage = null %}

{% set backendIncomplete = not setupStatus.backendReadinessValid %}
{% set configIncomplete = not setupStatus.configIndicesValid %}
{% set ipSaltIncomplete = not setupStatus.ipSaltConfigured %}

{% if backendIncomplete and configIncomplete and ipSaltIncomplete %}
    {% set setupMessage = 'Resolve unavailable backend assignments and configuration index issues before rebuilding affected indices, and finish setup before tracking search analytics.'|t('search-manager') %}
{% elseif backendIncomplete and configIncomplete %}
    {% set setupMessage = 'Resolve unavailable backend assignments and configuration index issues before rebuilding affected indices.'|t('search-manager') %}
{% elseif backendIncomplete and ipSaltIncomplete %}
    {% set setupMessage = 'Resolve unavailable backend assignments, and finish setup before tracking search analytics.'|t('search-manager') %}
{% elseif configIncomplete and ipSaltIncomplete %}
    {% set setupMessage = 'Resolve configuration index issues before rebuilding affected indices, and finish setup before tracking search analytics.'|t('search-manager') %}
{% elseif backendIncomplete %}
    {% set setupMessage = 'Resolve unavailable backend assignments.'|t('search-manager') %}
{% elseif configIncomplete %}
    {% set setupMessage = 'Resolve configuration index issues before rebuilding affected indices.'|t('search-manager') %}
{% elseif ipSaltIncomplete %}
    {% set setupMessage = 'Finish setup before tracking search analytics.'|t('search-manager') %}
{% endif %}

{% if currentSubnavItem != 'setup' %}
    {% include 'lindemannrock-base/_components/setup-incomplete' with {
        complete: setupStatus.complete,
        setupUrl: setupStatus.setupUrl,
        heading: 'Setup incomplete'|t('search-manager'),
        message: setupMessage,
        actionLabel: 'Open setup'|t('search-manager'),
    } only %}
{% endif %}
