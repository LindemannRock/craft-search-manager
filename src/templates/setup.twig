{% extends "_layouts/cp" %}

{% set selectedSubnavItem = 'setup' %}
{% set title = 'Set up {pluginName}'|t('search-manager', {
    pluginName: searchHelper.fullName,
}) %}
{% set allComplete = ipSaltConfigured and configIndicesValid and backendReadinessValid %}
{% set searchFullNameHtml = searchHelper.fullName|e %}

{% set ipSaltIncompleteBody %}
    <p>
        {{ 'Analytics tracking requires a secure salt for privacy protection.'|t('lindemannrock-base') }}
    </p>
    <p>
        <strong>{{ 'Run one of these commands in your terminal:'|t('lindemannrock-base') }}</strong>
    </p>
{% endset %}

{% set ipSaltFooter %}
    <p>
        {{ 'This will automatically add {envVar} to your .env file.'|t('lindemannrock-base', {envVar: '<code>SEARCH_MANAGER_IP_SALT</code>'})|raw }}
    </p>
    <p>
        <strong>{{ 'Warning:'|t('lindemannrock-base') }}</strong>
        {{ 'Copy the same salt to staging and production environments.'|t('lindemannrock-base') }}
    </p>
{% endset %}

{% set configIndexTasks = [] %}

{% if configIndexFindingGroups is empty %}
    {% set configIndexTasks = [{
        done: true,
        heading: 'Configuration indices'|t('search-manager'),
        description: 'No configuration index issues found.'|t('search-manager'),
        complete: {
            heading: 'Configuration indices are ready.'|t('search-manager'),
            body: 'Index rebuilds can proceed with the current configuration.'|t('search-manager'),
        },
    }] %}
{% else %}
    {% for group in configIndexFindingGroups %}
        {% set groupBody %}
            <p>
                {{ group.handle is null
                    ? 'Review config/search-manager.php before rebuilding affected indices.'|t('search-manager')
                    : 'Review this index in config/search-manager.php before rebuilding it.'|t('search-manager') }}
            </p>
            {% include 'search-manager/_components/_index-findings' with {
                findings: group.findings,
                listClass: 'lr-setup-task__list',
            } only %}
        {% endset %}
        {% set groupHeading = group.handle is null
            ? 'Configuration index issues'|t('search-manager')
            : ('Index'|t('search-manager') ~ ': ' ~ group.handle) %}
        {% set configIndexTasks = configIndexTasks|merge([{
            done: group.severity != 'error',
            heading: loop.first ? 'Configuration indices'|t('search-manager') : null,
            description: loop.first
                ? (configIndicesValid
                    ? 'Configuration indices are valid, with warnings to review.'|t('search-manager')
                    : '{pluginName} found configuration index issues that can affect indexing.'|t('search-manager', {
                        pluginName: searchHelper.fullName,
                    }))
                : null,
            complete: {
                heading: groupHeading,
                bodyHtml: groupBody,
                status: 'warning',
                variant: 'colored',
            },
            incomplete: {
                heading: groupHeading,
                bodyHtml: groupBody,
                status: 'error',
            },
        }]) %}
    {% endfor %}
{% endif %}

{% set backendReadinessTasks = [] %}

{% if backendReadinessFindingGroups is not empty %}
    {% for group in backendReadinessFindingGroups %}
        {% set groupBody %}
            {% include 'search-manager/_components/_index-findings' with {
                findings: group.findings,
                listClass: 'lr-setup-task__list',
            } only %}
        {% endset %}
        {% set backendReadinessTasks = backendReadinessTasks|merge([{
            done: false,
            heading: loop.first ? 'Backends'|t('search-manager') : null,
            description: loop.first ? 'Resolve unavailable backend assignments.'|t('search-manager') : null,
            incomplete: {
                heading: group.handle is null
                    ? 'Default Backend'|t('search-manager')
                    : ('Index'|t('search-manager') ~ ': ' ~ group.handle),
                bodyHtml: groupBody,
                status: 'error',
            },
        }]) %}
    {% endfor %}
{% endif %}

{% set setupConfig = {
    plugin: {
        handle: 'search-manager',
        name: searchHelper.fullName,
        version: pluginVersion ? ('v{version}'|t('search-manager', {version: pluginVersion})) : null,
        iconSvg: pluginIconSvg,
        logoPaths: logoPaths,
        heroStyle: pluginHeroStyle,
    },
    page: {
        badge: allComplete ? 'Ready'|t('search-manager') : 'Setup'|t('search-manager'),
        title: searchHelper.fullName,
        description: 'Complete this step before tracking search analytics.'|t('search-manager'),
    },
    tasks: [{
        done: ipSaltConfigured,
        heading: 'IP salt'|t('search-manager'),
        description: ipSaltConfigured ? 'Analytics privacy salt is ready for search analytics.'|t('search-manager') : 'Analytics needs a privacy salt before search analytics is ready.'|t('search-manager'),
        complete: {
            heading: 'IP hash salt is configured.'|t('search-manager'),
            body: 'Analytics privacy salt is ready for search analytics.'|t('search-manager'),
        },
        incomplete: {
            heading: 'IP hash salt is missing.'|t('lindemannrock-base'),
            bodyHtml: ipSaltIncompleteBody,
            commands: [
                {
                    legend: 'Standard:'|t('lindemannrock-base'),
                    value: 'php craft search-manager/security/generate-salt',
                    copyLabel: 'Copy'|t('lindemannrock-base'),
                    copiedMessage: 'Copied!'|t('lindemannrock-base'),
                },
                {
                    legend: 'DDEV:'|t('lindemannrock-base'),
                    value: 'ddev craft search-manager/security/generate-salt',
                    copyLabel: 'Copy'|t('lindemannrock-base'),
                    copiedMessage: 'Copied!'|t('lindemannrock-base'),
                },
            ],
            footerHtml: ipSaltFooter,
        },
    }]|merge(configIndexTasks)|merge(backendReadinessTasks),
} %}

{% block content %}
    {% embed 'lindemannrock-base/_layouts/cp-plugin-setup' with {
        setupConfig: setupConfig,
        allComplete: allComplete,
        ipSaltConfigured: ipSaltConfigured,
        pluginIconSvg: pluginIconSvg,
        pluginHeroStyle: pluginHeroStyle,
        logoPaths: logoPaths,
        searchFullNameHtml: searchFullNameHtml,
    } only %}
        {% block summary %}
            {% if allComplete %}
                {% include 'lindemannrock-base/_components/info-box' with {
                    message: '<strong>' ~ 'Setup complete.'|t('search-manager') ~ '</strong> ' ~ '{pluginName} is ready to track search analytics.'|t('search-manager', {
                        pluginName: searchFullNameHtml,
                    }),
                    type: 'success',
                    variant: 'colored',
                    margin: 'none',
                    allowHtml: true,
                } only %}
            {% endif %}
        {% endblock %}
    {% endembed %}
{% endblock %}
