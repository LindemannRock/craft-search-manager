{# Package-owned Search Manager comparison page. #}
{% set indexRecords = craft.searchManager.getAvailableIndices() %}
{% set indexHandles = indexRecords|map(index => index.handle) %}
{% set initialIndex = 'all-sites' in indexHandles ? 'all-sites' : (indexHandles[0] ?? '') %}
{% set activeIndex = craft.app.request.getParam('smIndex') ?? initialIndex %}
{% set activeIndex = activeIndex == '__all' or activeIndex in indexHandles ? activeIndex : initialIndex %}
{% set query = craft.app.request.getParam('q') ?? '' %}
{% set results = null %}
{% if query|length >= 2 %}
    {% set results = activeIndex == '__all'
        ? craft.searchManager.searchMultiple(indexHandles, query, {skipAnalytics: true})
        : craft.searchManager.search(activeIndex, query, {skipAnalytics: true}) %}
{% endif %}
<!doctype html>
<html><body data-index="{{ activeIndex }}">{{ results.total ?? 0 }}</body></html>
