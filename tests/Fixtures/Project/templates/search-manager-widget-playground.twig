							<strong>{{ index.handle }}</strong>
							<span>{{ index.name ?? index.handle }}</span>
						</div>
					{% else %}
						<p>No Search Manager indices are configured.</p>
					{% endfor %}
				</div>
			</section>
		</main>

		<script>
			(function () {
				var button = document.querySelector('[data-theme-toggle]');
				if (!button) {
					return;
				}

				var root = document.documentElement;
				var media = window.matchMedia('(prefers-color-scheme: dark)');

				function currentTheme() {
					return root.dataset.theme || (media.matches ? 'dark' : 'light');
				}

				function updateLabel() {
					var theme = currentTheme();
					button.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
					document.querySelectorAll('search-modal').forEach(function (widget) {
						widget.setAttribute('theme', theme);
					});
				}

				button.addEventListener('click', function () {
					var next = currentTheme() === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					localStorage.setItem('searchWidgetTestTheme', next);
					updateLabel();
				});

				media.addEventListener('change', function () {
					if (!root.dataset.theme) {
						updateLabel();
					}
				});

				updateLabel();
			})();
		</script>
