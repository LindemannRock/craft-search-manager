				<p>
					The default widget needs only the include. For a branded trigger, render your own button and connect it with
					<code>triggerSelector</code>
					.
				</p>
				<pre><code>{% verbatim %}{% include 'search-manager/_widget/search-modal' %}

<button id="site-search-trigger" type="button">Search site</button>

{% include 'search-manager/_widget/search-modal' with {
    triggerEnabled: false,
    triggerSelector: '#site-search-trigger',
    indexHandles: ['entries'],
    placeholder: 'Search content...',
    styles: {
        modalBorderRadius: '8',
        resultActiveBg: '#ccfbf1',
    },
} %}{% endverbatim %}</code></pre>
