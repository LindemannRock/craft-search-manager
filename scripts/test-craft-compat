#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  scripts/test-craft-compat <craft-constraint> [package-version] [--install] [--php-version <major.minor>] [--smoke-command <command>] [--keep-project-dev] [--allow-insecure-floor]

Examples:
  scripts/test-craft-compat '^5.10'
  scripts/test-craft-compat '^5.10' dev-main
  scripts/test-craft-compat '^5.10' dev-main --install --php-version 8.2
  scripts/test-craft-compat '^5.10' dev-main --install --php-version 8.5
  scripts/test-craft-compat '5.10.0' dev-main --allow-insecure-floor

What it does:
  1. Creates one exactly owned disposable Craft project.
  2. Pins Composer platform PHP to the exact requested DDEV PHP row.
  3. Resolves the requested Craft constraint.
  4. Installs this local candidate through a non-symlink Composer path repository.
  5. In --install mode, starts an exactly named DDEV project, installs Craft,
     installs/enables Craft plugins or requires module smoke, and runs the
     package-owned smoke test.

Composer-only mode is the default. Use --install for fresh-install/bootstrap
and meaningful package-smoke evidence.

The disposable project's require-dev packages are removed by default so the
check reflects a consumer install. Use --keep-project-dev only when the Craft
starter project's dev tools are intentionally part of the probe.

The project and its exact DDEV/database/container resources are always removed
on success, failure, INT, TERM, and HUP. This runner never retains projects.

Use --allow-insecure-floor only for historical reproduction where Composer
blocks an old Craft/dependency patch because of advisories. It is never normal
release validation.

When --install is used, a package-owned scripts/smoke-test is mandatory. A
--smoke-command runs only after that package smoke; it does not replace it.
USAGE
}

if [[ $# -lt 1 || "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

CRAFT_CONSTRAINT="$1"
PACKAGE_VERSION="dev-main"
PACKAGE_VERSION_SET=false
INSTALL_MODE=false
ALLOW_INSECURE_FLOOR=false
PHP_VERSION="8.3"
SMOKE_COMMAND=""
KEEP_PROJECT_DEV=false

shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --install)
      INSTALL_MODE=true
      ;;
    --allow-insecure-floor)
      ALLOW_INSECURE_FLOOR=true
      ;;
    --php-version)
      if [[ -z "${2:-}" ]]; then
        echo "--php-version requires an exact major.minor value, such as 8.3" >&2
        exit 1
      fi
      PHP_VERSION="$2"
      shift
      ;;
    --smoke-command)
      if [[ -z "${2:-}" ]]; then
        echo "--smoke-command requires a command string" >&2
        exit 1
      fi
      SMOKE_COMMAND="$2"
      shift
      ;;
    --keep-project-dev)
      KEEP_PROJECT_DEV=true
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
    *)
      if [[ "$PACKAGE_VERSION_SET" == true ]]; then
        echo "Unexpected positional argument: $1" >&2
        usage
        exit 1
      fi
      PACKAGE_VERSION="$1"
      PACKAGE_VERSION_SET=true
      ;;
  esac

  shift
done

if [[ ! "$PHP_VERSION" =~ ^[0-9]+\.[0-9]+$ ]]; then
  echo "--php-version must be an exact major.minor row, such as 8.2 or 8.5: $PHP_VERSION" >&2
  exit 1
fi

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
PACKAGE_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
PACKAGE_NAME="$(php -r '$data = json_decode(file_get_contents($argv[1]), true); echo $data["name"] ?? "";' "$PACKAGE_DIR/composer.json")"
PACKAGE_HANDLE="$(php -r '$data = json_decode(file_get_contents($argv[1]), true); echo $data["extra"]["handle"] ?? "";' "$PACKAGE_DIR/composer.json")"
PACKAGE_TYPE="$(php -r '$data = json_decode(file_get_contents($argv[1]), true); echo $data["type"] ?? "";' "$PACKAGE_DIR/composer.json")"

if [[ -z "$PACKAGE_NAME" || -z "$PACKAGE_HANDLE" || -z "$PACKAGE_TYPE" ]]; then
  echo "Unable to read package name, type, and extra.handle from composer.json." >&2
  exit 1
fi
if [[ ! "$PACKAGE_HANDLE" =~ ^[a-z][a-z0-9-]*$ ]]; then
  echo "Unsupported package handle for an isolated compatibility project: $PACKAGE_HANDLE" >&2
  exit 1
fi
if [[ "$PACKAGE_TYPE" != "craft-plugin" && "$PACKAGE_TYPE" != "yii2-module" ]]; then
  echo "Unsupported package type: $PACKAGE_TYPE (expected craft-plugin or yii2-module)." >&2
  exit 1
fi

SAFE_HANDLE="$(printf '%s' "$PACKAGE_HANDLE" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9-' '-')"
SAFE_CONSTRAINT="$(printf '%s' "$CRAFT_CONSTRAINT" | tr -c '[:alnum:]' '-')"
TEMP_ROOT="${CRAFT_COMPAT_TEMP_ROOT:-${TMPDIR:-/tmp}}"
mkdir -p -- "$TEMP_ROOT"
TEMP_ROOT="$(CDPATH= cd -- "$TEMP_ROOT" && pwd -P)"

case "$TEMP_ROOT" in
  /|"${HOME:-}")
    echo "Refusing unsafe compatibility temporary root: $TEMP_ROOT" >&2
    exit 1
    ;;
esac

PROJECT_PREFIX="craft-compat-${SAFE_HANDLE}-${SAFE_CONSTRAINT}."
PROJECT_DIR="$(mktemp -d "$TEMP_ROOT/${PROJECT_PREFIX}XXXXXXXX")"
PROJECT_BASENAME="$(basename "$PROJECT_DIR")"
PROJECT_TOKEN="${PROJECT_BASENAME##*.}"
DDEV_HANDLE="$(printf '%s' "$SAFE_HANDLE" | cut -c1-40)"
DDEV_PROJECT_TOKEN="$(printf '%s' "$PROJECT_TOKEN" | tr '[:upper:]' '[:lower:]')"
DDEV_PROJECT_NAME="compat-${DDEV_HANDLE}-${DDEV_PROJECT_TOKEN}"
DDEV_OWNED=false

cleanup_owned_resources() {
  primary_status=$?
  cleanup_status=0
  trap - EXIT INT TERM HUP
  set +e

  if [[ "$DDEV_OWNED" == true ]]; then
    (
      cd "$PROJECT_DIR" 2>/dev/null || exit 1
      ddev delete -Oy "$DDEV_PROJECT_NAME"
    )
    ddev_status=$?
    if [[ "$ddev_status" -ne 0 ]]; then
      echo "Failed to remove owned DDEV project $DDEV_PROJECT_NAME (exit $ddev_status)." >&2
      cleanup_status="$ddev_status"
    else
      echo "Removed owned DDEV project: $DDEV_PROJECT_NAME"
    fi
  fi

  if [[ -e "$PROJECT_DIR" ]]; then
    if [[ "$(dirname "$PROJECT_DIR")" == "$TEMP_ROOT" && "$(basename "$PROJECT_DIR")" == "$PROJECT_PREFIX"* ]]; then
      rm -rf -- "$PROJECT_DIR"
      filesystem_status=$?
      if [[ "$filesystem_status" -ne 0 || -e "$PROJECT_DIR" ]]; then
        [[ "$filesystem_status" -eq 0 ]] && filesystem_status=1
        echo "Failed to remove owned compatibility project $PROJECT_DIR (exit $filesystem_status)." >&2
        if [[ "$cleanup_status" -eq 0 ]]; then
          cleanup_status="$filesystem_status"
        fi
      else
        echo "Removed owned compatibility project: $PROJECT_DIR"
      fi
    else
      echo "Refusing to remove unexpected compatibility project path: $PROJECT_DIR" >&2
      if [[ "$cleanup_status" -eq 0 ]]; then
        cleanup_status=1
      fi
    fi
  fi

  if [[ "$primary_status" -ne 0 ]]; then
    exit "$primary_status"
  fi
  exit "$cleanup_status"
}

handle_signal() {
  exit "$1"
}

trap cleanup_owned_resources EXIT
trap 'handle_signal 130' INT
trap 'handle_signal 143' TERM
trap 'handle_signal 129' HUP

if [[ "$(dirname "$PROJECT_DIR")" != "$TEMP_ROOT" || "$PROJECT_BASENAME" != "$PROJECT_PREFIX"* \
  || ! "$DDEV_PROJECT_NAME" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ || ${#DDEV_PROJECT_NAME} -gt 63 ]]; then
  echo "Generated compatibility ownership boundary is invalid." >&2
  exit 1
fi

echo "Compatibility candidate: $PACKAGE_NAME:$PACKAGE_VERSION"
echo "Package source: $PACKAGE_DIR"
echo "Package type/handle: $PACKAGE_TYPE / $PACKAGE_HANDLE"
echo "Requested Craft constraint: $CRAFT_CONSTRAINT"
echo "Requested PHP row: $PHP_VERSION"
echo "Owned project/DDEV identity: $PROJECT_DIR / $DDEV_PROJECT_NAME"

echo "Creating disposable Craft project scaffold"
composer create-project craftcms/craft "$PROJECT_DIR" --no-interaction --no-scripts --no-install --quiet

cd "$PROJECT_DIR"

if [[ "$KEEP_PROJECT_DEV" != true ]]; then
  echo "Removing disposable Craft project require-dev packages"
  php -r '$path = "composer.json"; $data = json_decode(file_get_contents($path), true); unset($data["require-dev"]); file_put_contents($path, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL);'
fi

if [[ "$ALLOW_INSECURE_FLOOR" == true ]]; then
  echo "Disabling Composer advisory blocking for historical reproduction only"
  composer config --json audit.block-insecure false
fi

echo "Pinning Composer platform PHP to $PHP_VERSION.0"
composer config platform.php "$PHP_VERSION.0"

echo "Pinning craftcms/cms to $CRAFT_CONSTRAINT"
composer require "craftcms/cms:$CRAFT_CONSTRAINT" --no-interaction --no-scripts --update-with-all-dependencies

echo "Configuring non-symlink local path repository for $PACKAGE_NAME"
REPOSITORY_JSON="$(php -r 'echo json_encode(["type" => "path", "url" => $argv[1], "options" => ["symlink" => false, "versions" => [$argv[2] => $argv[3]]]], JSON_UNESCAPED_SLASHES);' "$PACKAGE_DIR" "$PACKAGE_NAME" "$PACKAGE_VERSION")"
composer config --json repositories.local-package "$REPOSITORY_JSON"
composer config minimum-stability dev
composer config prefer-stable true

echo "Installing local candidate $PACKAGE_NAME:$PACKAGE_VERSION"
composer require "$PACKAGE_NAME:$PACKAGE_VERSION" --no-interaction --no-scripts --update-with-all-dependencies

echo "Resolved versions:"
composer show craftcms/cms --no-ansi
composer show "$PACKAGE_NAME" --no-ansi
echo "Resolved direct dependency set:"
composer show --direct --no-ansi

COMPAT_DIR=".craft-compat"
LOCAL_SMOKE_SCRIPT="$PACKAGE_DIR/scripts/smoke-test"
PROJECT_SMOKE_SCRIPT="$COMPAT_DIR/smoke-test"

if [[ -f "$LOCAL_SMOKE_SCRIPT" ]]; then
  mkdir -p "$COMPAT_DIR"
  cp "$LOCAL_SMOKE_SCRIPT" "$PROJECT_SMOKE_SCRIPT"
  chmod +x "$PROJECT_SMOKE_SCRIPT"
fi

if [[ "$INSTALL_MODE" != true ]]; then
  echo "Composer compatibility check passed."
  exit 0
fi

if ! command -v ddev >/dev/null 2>&1; then
  echo "DDEV is required for --install mode." >&2
  exit 1
fi

echo "Starting DDEV fresh-install smoke test"
DDEV_OWNED=true
ddev config --project-name="$DDEV_PROJECT_NAME" --project-type=craftcms --docroot=web --php-version="$PHP_VERSION" --database=mysql:8.0 --auto >/dev/null
ddev start

ACTUAL_PHP_ROW="$(ddev exec php -r 'echo PHP_MAJOR_VERSION . "." . PHP_MINOR_VERSION;')"
echo "Actual DDEV PHP: $(ddev exec php -r 'echo PHP_VERSION;')"
if [[ "$ACTUAL_PHP_ROW" != "$PHP_VERSION" ]]; then
  echo "DDEV PHP row mismatch: requested $PHP_VERSION, got $ACTUAL_PHP_ROW" >&2
  exit 1
fi

ddev craft install \
  --interactive=0 \
  --username=admin \
  --password=password \
  --email=test@example.com \
  --site-name="Craft Compat ${PACKAGE_HANDLE}" \
  --site-url='$DDEV_PRIMARY_URL'

if [[ "$PACKAGE_TYPE" == "craft-plugin" ]]; then
  DEPENDENCY_HANDLES="$(php -r '$lock = json_decode(file_get_contents("composer.lock"), true); $target = $argv[1]; foreach (($lock["packages"] ?? []) as $package) { if (($package["name"] ?? "") === $target || ($package["type"] ?? "") !== "craft-plugin") { continue; } $handle = $package["extra"]["handle"] ?? ""; if ($handle !== "") { echo $handle, PHP_EOL; } }' "$PACKAGE_NAME")"

  if [[ -n "$DEPENDENCY_HANDLES" ]]; then
    echo "Installing required Craft plugin dependencies"
    while IFS= read -r DEPENDENCY_HANDLE; do
      [[ -z "$DEPENDENCY_HANDLE" ]] && continue
      ddev craft plugin/install "$DEPENDENCY_HANDLE"
    done <<< "$DEPENDENCY_HANDLES"
  fi

  ddev craft plugin/install "$PACKAGE_HANDLE"
  PACKAGE_LIST="$(ddev craft plugin/list)"
  echo "$PACKAGE_LIST"

  if ! grep -Eq "[[:space:]]$PACKAGE_HANDLE[[:space:]].*[[:space:]]Yes[[:space:]]+Yes" <<<"$PACKAGE_LIST"; then
    echo "Plugin $PACKAGE_HANDLE was not installed and enabled successfully." >&2
    exit 1
  fi
else
  echo "Yii module candidate resolved; its mandatory package smoke must prove module registration."
fi

SMOKE_SCRIPT=""
if ddev exec test -f "$PROJECT_SMOKE_SCRIPT" >/dev/null 2>&1; then
  SMOKE_SCRIPT="$PROJECT_SMOKE_SCRIPT"
elif ddev exec test -f "vendor/$PACKAGE_NAME/scripts/smoke-test" >/dev/null 2>&1; then
  SMOKE_SCRIPT="vendor/$PACKAGE_NAME/scripts/smoke-test"
fi

if [[ -z "$SMOKE_SCRIPT" ]]; then
  echo "No package smoke test found at $PROJECT_SMOKE_SCRIPT or vendor/$PACKAGE_NAME/scripts/smoke-test." >&2
  echo "--install requires package-owned meaningful runtime smoke." >&2
  exit 1
fi

echo "Running package smoke test: $SMOKE_SCRIPT"
ddev exec env PLUGIN_NAME="$PACKAGE_NAME" PLUGIN_HANDLE="$PACKAGE_HANDLE" PLUGIN_TYPE="$PACKAGE_TYPE" bash "$SMOKE_SCRIPT"

if [[ -n "$SMOKE_COMMAND" ]]; then
  echo "Running additional one-off smoke command after package smoke"
  ddev exec bash -lc "$SMOKE_COMMAND"
fi

echo "Fresh-install compatibility check passed for PHP $PHP_VERSION and $CRAFT_CONSTRAINT."
